# Dependencies (none today, but npm may create these)
node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Local environment and secrets
.env
.env.*

# Batch input and output: your files, not code. The folders stay, via .gitkeep.
input/*
out/*
!input/.gitkeep
!out/.gitkeep

# Temporary files written by the server while saving MP3s
.meta-tmp-*

# Local Claude Code settings and state
.claude/

# OS and editor files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
.idea/
.vscode/
*.swp
*~
